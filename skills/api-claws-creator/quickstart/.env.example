# Create this key in the Buda dashboard: Settings -> API Keys.
# It is shown exactly once, prefixed sk_. Keep it server-side; never ship it to a browser,
# mobile app, mini program, or device.
BUDA_API_KEY=sk_your_api_key

# Defaults are fine. Override only if you are pointed at another deployment.
# BUDA_API_BASE_URL=https://buda.im/api/v1

# The Space and Agent the quickstart provisions. Re-running reuses them instead of duplicating.
# QUICKSTART_SPACE_NAME=API Claws Quickstart
# QUICKSTART_AGENT_NAME=Watch Assistant
