# Create this key in the Buda dashboard: Settings -> API Keys.
# It is shown exactly once, prefixed sk_. Keep it server-side; never ship it to a browser,
# mobile app, mini program, or device.
BUDA_API_KEY=sk_your_api_key

# Defaults are fine. Override only if you are pointed at another deployment.
# BUDA_API_BASE_URL=https://buda.im/api/v1

# The agent runs in your API Claws Developer Space. Create it once in the Developer Center
# (https://buda.im/developer -> enable API Claws) and top up its credits. Set this only if the
# account has more than one Developer Space.
# QUICKSTART_SPACE_ID=org...

# The agent the quickstart creates in that Space. Re-running reuses it instead of duplicating.
# QUICKSTART_AGENT_NAME=Watch Assistant

# How long to poll one turn before stopping (ms). The run keeps going server-side either way.
# QUICKSTART_POLL_TIMEOUT_MS=180000
